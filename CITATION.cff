    family-names: Alvarez
    email: erik.alvarez@ri.se
    affiliation: "RISE Research Institutes of Sweden, Gothenburg, Sweden"
    orcid: "https://orcid.org/0000-0003-3862-9747"
  - given-names: "Juan F."
    family-names: Gutierrez-Guerra
    affiliation: "Institute for Research in Technology (IIT), Comillas Pontifical University, Madrid, Spain"
    orcid: "https://orcid.org/0000-0001-9441-3073"
  - given-names: Andres
    family-names: Ramos
    affiliation: "Institute for Research in Technology (IIT), Comillas Pontifical University, Madrid, Spain"
    orcid: "https://orcid.org/0000-0002-8871-1872"
version: "1.0.1-h2vppfcr"
date-released: "2026-08-10"
license: GPL-3.0-or-later
repository-code: "https://github.com/EL1XR-dev/el1xr_opt"
doi: "10.5281/zenodo.21865129"
url: "https://el1xr-opt.readthedocs.io/en/latest/"
keywords:
